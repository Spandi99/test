# Copy this file to .env.pi and adjust values before running on your Pi
POSTGRES_USER=fluid
POSTGRES_PASSWORD=fluid
POSTGRES_DB=fluid_calendar
POSTGRES_PORT=5432
RADICALE_USERNAME=fluid
RADICALE_PASSWORD=fluid
RADICALE_BASE_URL=http://localhost:5232
DATABASE_URL=postgresql://fluid:fluid@127.0.0.1:5432/fluid_calendar?schema=public
# Replace with the URL you'll use to access the Pi from your network
NEXTAUTH_URL=http://raspberrypi.local:3000
NEXT_PUBLIC_APP_URL=http://raspberrypi.local:3000
# Generate with: head -c 32 /dev/urandom | base64 | tr -d '\n'
NEXTAUTH_SECRET=generate-a-long-random-string
